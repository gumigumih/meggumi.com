---
import '../styles/tailwind.css'
import SiteHead from '../components/SiteHead.astro'
import SiteHeader from '../components/SiteHeader.astro'
import SiteFooter from '../components/SiteFooter.astro'

const release = 'https://github.com/gumigumih/exif-copy-tool/releases/latest'
const download = (filename: string) => `${release}/download/${filename}`
const sample = '📷 SONY ILCE-7CR\n🔭 FE 20-70mm F4 G\n⚙️ 70mm / F4 / 1/20 / ISO100'
---
<!DOCTYPE html>
<html lang="ja">
<head>
  <SiteHead
    title="EXIF Copy Tool ダウンロード | meg+gumi"
    description="写真のEXIF情報を右クリックでコピー。Windows版・Mac版のダウンロードと使い方。"
    canonicalPath="/exif-copy-tool/"
    image="https://meggumi.com/assets/images/exif-copy-tool/ogp.png"
  />
</head>
<body class="bg-white font-sans text-[#162235]">
  <SiteHeader />
  <main class="page-main mx-auto w-full max-w-6xl px-5 pb-16 pt-24 md:px-8 md:pt-32">
    <nav aria-label="パンくずリスト" class="text-sm">
      <a class="text-slate-600 underline underline-offset-4" href="/works/exif-copy-tool/">← EXIF Copy Toolの制作事例</a>
    </nav>
    <section aria-labelledby="exif-title" class="grid items-center gap-8 border-b border-slate-200 py-10 md:grid-cols-2 md:gap-12">
      <div>
        <p class="text-sm font-bold uppercase tracking-widest text-[#a31f62]">Windows / macOS</p>
        <h1 id="exif-title" class="mt-3 text-[clamp(2rem,6vw,4rem)] font-black leading-tight tracking-tight">EXIF Copy Tool</h1>
        <p class="mt-4 max-w-lg text-lg leading-relaxed text-slate-700">写真を右クリックして、カメラ名や撮影設定をまとめてコピー。SNSやブログに、いつもの書式でそのまま貼れます。</p>
      </div>
      <figure class="min-w-0 rounded-lg bg-[#162235] p-5 text-white md:p-7">
        <figcaption class="text-sm font-bold text-slate-300">コピー結果の例</figcaption>
        <pre class="mt-3 whitespace-pre-wrap break-words text-sm leading-7">{sample}</pre>
      </figure>
    </section>

    <section aria-labelledby="exif-download" class="py-10">
      <h2 id="exif-download" class="text-2xl font-bold md:text-3xl">ダウンロードと使い方</h2>
      <div class="mt-6 grid items-stretch gap-5 md:grid-cols-2">
        <section class="flex min-w-0 flex-col rounded-lg border border-slate-300 p-5 md:p-7" aria-labelledby="exif-windows">
          <h3 id="exif-windows" class="text-xl font-bold">Windows版</h3>
          <p class="mt-2 text-sm text-slate-700">Windows 10 / 11</p>
          <a class="download-link mt-5" href={download('ExifCopyToolSetup.exe')}>Windows版をダウンロード（.exe）</a>
          <a class="mt-3 w-fit text-sm text-slate-700 underline underline-offset-4" href={download('ExifCopyTool.zip')}>インストーラーなしで試す（.zip）</a>
          <ol class="mt-6 list-decimal space-y-2 pl-5 text-sm leading-relaxed text-slate-700">
            <li>インストーラーを開いて、画面の案内に従います。</li>
            <li>写真を右クリックし、「EXIF情報をコピー」から書式を選びます。</li>
          </ol>
        </section>
        <section class="flex min-w-0 flex-col rounded-lg border border-slate-300 p-5 md:p-7" aria-labelledby="exif-mac">
          <h3 id="exif-mac" class="text-xl font-bold">Mac版</h3>
          <p class="mt-2 text-sm text-slate-700">Apple Silicon搭載Mac（macOS 13以降）</p>
          <a class="download-link mt-5" href={download('ExifCopyTool-macOS.dmg')}>Mac版をダウンロード（.dmg）</a>
          <ol class="mt-6 list-decimal space-y-2 pl-5 text-sm leading-relaxed text-slate-700">
            <li>DMGを開き、ExifCopyTool.appを「アプリケーション」に移します。</li>
            <li>同梱の「クイックアクションをインストール.command」を実行します。</li>
            <li>Finderで写真を右クリックし、「サービス」から書式を選びます。</li>
          </ol>
        </section>
      </div>
      <p class="mt-5 max-w-3xl text-sm leading-relaxed text-slate-700">配布ファイルはGitHubから取得します。Windows版・Mac版ともに未署名のため、初回起動時にOSの警告が表示される場合があります。</p>
      <a class="mt-2 inline-flex min-h-11 items-center text-sm font-semibold text-slate-700 underline underline-offset-4" href={release}>リリースノート・全ファイルをGitHubで見る</a>
    </section>

    <section aria-labelledby="exif-settings" class="border-t border-slate-200 pt-8">
      <h2 id="exif-settings" class="text-xl font-bold">書式と対応ファイル</h2>
      <p class="mt-3 max-w-3xl leading-relaxed text-slate-700">「フォーマット編集」で、撮影日時、カメラ、レンズ、ISO感度などを選んで並べられます。JPEG、HEIC、TIFFやRAWなどを想定しています。取得できる情報はファイルや環境によって異なります。</p>
    </section>
  </main>
  <SiteFooter />
</body>
</html>
<style>
  .download-link {
    display: inline-flex;
    width: fit-content;
    min-height: 3rem;
    align-items: center;
    border-radius: .375rem;
    background: #162235;
    padding: .65rem 1rem;
    color: #fff;
    font-size: .875rem;
    font-weight: 700;
  }

  .download-link:hover { background: #2c405d; }

  main a:focus-visible { outline: 2px solid #a31f62; outline-offset: 4px; }
</style>
